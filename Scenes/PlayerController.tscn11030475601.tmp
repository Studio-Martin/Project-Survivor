[sub_resource type="GDScript" id="GDScript_swwnm"]
script/source = "extends Node
class_name HealthComponent

@export var maxHealth : int = 5

signal died

@onready var health : int = maxHealth

func take_damage(attack : Attack) -> void:
	
	print(owner.name, \" take \", attack.damageAmout, \" damage\")
	
	health -= attack.damageAmout
	
	if health <= 0:
		
		died.emit()
		owner.queue_free()

func heal(amount : int) -> void:
	
	if health < maxHealth:
		
		health += amount
"

[sub_resource type="GDScript" id="GDScript_aiwxb"]
script/source = "extends Area2D
class_name HurtBoxComponent

@export var Health : HealthComponent

func _ready():
	
	area_entered.connect(_on_area_entered)

func _on_area_entered(area : Area2D):
	
	if area is HitBoxComponent and area.owner != owner and area.owner.is_in_group(\"Ally\"):
		
		print(\"i'm getting hurt\")
		
		Health.take_damage(area.attack)
"

